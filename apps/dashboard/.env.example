# TokSuan Dashboard
# Copy to .env.local

DATABASE_URL=postgres://tokensmart:tokensmart_dev@localhost:5432/tokensmart

# Internal URL the dashboard uses for its OWN server-side RPC calls to the
# gateway (/health, /internal/replay). In K8s / multi-service deploys this
# can be an internal service address that isn't reachable from the public
# internet. Unset falls back to http://localhost:8787.
GATEWAY_URL=http://localhost:8787

# Public URL we TELL THE USER to curl. Shown in the "How to point an agent
# here" card, every copy-paste snippet on /projects/[id], and dashboard
# empty-state nudges. In hosted production set this to your public gateway
# domain. Leave unset for local dev — it falls back through GATEWAY_URL to
# http://localhost:8787 so nobody has to configure anything to start
# hacking.
#
# Example (hosted prod):
#   GATEWAY_PUBLIC_URL=https://gateway.tokensmt.com
#
# GATEWAY_PUBLIC_URL=

# --- Auth (hosted mode) -----------------------------------------------------
# Leave unset or 0 for single-tenant self-hosting: the dashboard shows every
# project's data, no login gate. Set to 1 to require email + OTP login and
# scope all pages to the signed-in user's projects.
#
# TOKENSMART_AUTH_ENABLED=1

# --- Runtime audience flag --------------------------------------------------
# Set to 1 on the public hosted SaaS deploy (tokensmt.com). Leave unset for
# OSS / self-host / developer machines.
#
# What changes when hosted mode is on:
#   - /login stops telling users "the code is also printed in the server log"
#   - /settings "Encryption key not configured" banner is suppressed (if
#     keys aren't encrypted that's a platform-side problem, not customer-
#     actionable; on-call gets paged from /health instead)
#   - /settings weekly digest card shows the next scheduled send time
#     instead of "operator must run the cron"
#
# TOKENSMART_HOSTED_MODE=1

# --- Email delivery (optional) ---------------------------------------------
# Login OTPs are always printed to the dashboard server console for dev.
# Set RESEND_API_KEY to additionally send them via email (via resend.com).
# RESEND_FROM defaults to TokSuan <onboarding@resend.dev> until you verify
# a domain in Resend — then flip it to no-reply@mail.tokensmt.com (or similar).
#
# RESEND_API_KEY=re_...
# RESEND_FROM=TokSuan <no-reply@mail.tokensmt.com>
#
# Dev-only escape hatch: production suppresses plaintext OTP/magic-link logs.
# Set to 1 only on a trusted self-host box where log access is tightly scoped.
# TOKENSMART_LOG_LOGIN_CODES=0

# --- Stripe billing (optional) ---------------------------------------------
# Only needed if you want the /billing upgrade flow. The free tier works
# without any of these. Create the products + prices in the Stripe dashboard
# first, then put the price IDs here.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Monthly Stripe price IDs — the upgrade buttons charge these.
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_SCALE=price_...        # v0.2.x — new Scale tier ($499/mo cap)
#
# Annual Stripe price IDs (17% discount). Optional — many operators only
# offer monthly until they have annual demand. The dashboard ad shows the
# annual rate even when the price ID is unset; users just can't check out
# annually until the env var is wired.
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_TEAM_ANNUAL=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...
#
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- BYO upstream provider keys --------------------------------------------
# Master key for AES-256-GCM encryption of customer-supplied OpenAI /
# Anthropic / etc. credentials uploaded via Settings → Provider keys.
#
# CRITICAL: this MUST be identical to the gateway's
# `TOKENSMART_PROVIDER_KEY_ENCRYPTION`. Rotating it makes every stored
# customer key unreadable.
#
# Generate with:
#   openssl rand -hex 32
#
# When unset, the Settings page shows a banner explaining the BYO feature
# is disabled and the gateway will use its own env-configured upstream
# credentials instead.
#
# TOKENSMART_PROVIDER_KEY_ENCRYPTION=...

# --- BYO keys via AWS KMS (production multi-tenant) ------------------------
#
# Same semantics as the gateway — set both env vars identically on the
# dashboard. The dashboard uses KMS GenerateDataKey for encrypts only.
# Needs the same IAM policy (kms:GenerateDataKey on the CMK is sufficient
# for the dashboard; Decrypt only if you ever let admins view plaintext).
#
# TOKENSMART_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/abcd-...
# AWS_REGION=us-east-1
# TOKENSMART_KMS_ENDPOINT_URL=  # optional, LocalStack only

# Or use GCP KMS instead (mutually exclusive with AWS):
# TOKENSMART_GCP_KMS_KEY_NAME=projects/my-project/locations/global/keyRings/toksuan/cryptoKeys/byo-keys

# --- Internal endpoints (v0.3 request-replay) ------------------------------
#
# Explicit opt-in plus a shared secret authenticating the dashboard's calls to
# the gateway's `/internal/replay` endpoint (Replay button on /requests/[id]).
# MUST be byte-identical to the gateway's `TOKENSMART_INTERNAL_TOKEN`. When
# either value is unset, the Replay card shows setup instructions.
# Generate with: openssl rand -hex 32
#
# TOKENSMART_INTERNAL_REPLAY_ENABLED=1
# TOKENSMART_INTERNAL_TOKEN=

# --- Operator authorization (v0.3 referral settle pass) --------------------
#
# Comma-separated emails of users authorized to run the operator-only
# "Run settle pass now" button on /referrals (which mints Stripe customer-
# balance credits for pending referral commissions). Defaults to none —
# any non-listed user clicking the button gets a clear error toast.
#
# TOKENSMART_OPS_EMAILS=you@example.com
