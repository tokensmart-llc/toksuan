# TokSuan Gateway — environment variables
# Copy to .env and fill in. Only the variables you use need to be set.

# --- Server ----------------------------------------------------------------
PORT=8787
NODE_ENV=development

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://tokensmart:tokensmart_dev@localhost:5432/tokensmart

# --- Schema migrations (auto-applied at boot) ------------------------------
# The gateway runs `runPendingMigrations()` at boot — applies any SQL files
# in migrations/ that aren't yet recorded in the schema_migrations table.
# Idempotent; safe to leave on.
#
# Set to 0 to disable (useful in CI pipelines or multi-replica deploys
# where exactly one process should drive migrations). Gateway will warn
# if there are pending files but won't apply them.
# TOKENSMART_AUTO_MIGRATE=1
#
# Where to find the migrations/ directory. Auto-detected from cwd by
# default — only set this if you have an unusual layout.
# TOKENSMART_MIGRATIONS_DIR=/path/to/migrations

# --- Upstream providers ----------------------------------------------------
# TokSuan routes each chat completion to the provider whose model pattern
# matches. Uncomment just the ones you have credentials for — the gateway
# refuses to start if none are configured. Base URL overrides are optional;
# sensible defaults are built in.

# OpenAI (gpt-*, o1-*, o3-*, o4-*)
# Multiple keys are supported via comma-separation — the gateway round-robins
# requests across them and benches any key that returns 429 for the cooldown
# window (default 30s, see TOKENSMART_KEY_COOLDOWN_MS below).
# OPENAI_API_KEY=sk-...,sk-...,sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (deepseek-chat, deepseek-reasoner)
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen (qwen-*), via Dashscope
# QWEN_API_KEY=...
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Doubao (doubao-*, ep-*), via Volcengine Ark
# DOUBAO_API_KEY=...
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Anthropic (claude-*) — also unlocks auto cache_control injection on outbound
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini, via Google's OpenAI-compatible endpoint (gemini-*)
# GOOGLE_API_KEY=...
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Feature flags ---------------------------------------------------------

# Auto-inject `cache_control: { type: "ephemeral" }` markers on Anthropic
# requests so prompt-cache reuse is automatic instead of opt-in. Default ON.
# TOKENSMART_AUTO_CACHE_CONTROL=1

# Complexity classifier mode. Default `byo_same_provider` uses a cheap judge
# model from the same provider family as the caller's requested model, resolved
# through that user's BYO key. If no same-provider BYO key is available, the
# gateway falls back to the local heuristic and does NOT spend platform money.
# Values: byo_same_provider | explicit | heuristic
# TOKENSMART_CLASSIFIER_MODE=byo_same_provider
#
# Optional explicit judge override. Only used when
# TOKENSMART_CLASSIFIER_MODE=explicit, or when a request supplies
# `x-ts-classifier-model`. Explicit mode is useful for self-host/demo installs
# where the operator accepts paying for a shared judge model.
# TOKENSMART_CLASSIFIER_MODEL=gpt-4o-mini

# Baseline cold-start routing is ON by default. Runtime routing skips policy
# candidates whose provider has neither a user BYO key nor gateway env key.
# TOKENSMART_BASELINE_POLICY_ENABLED=1

# --- Embedding-based task classifier --------------------------------------
# fastText-style hashed-trigram + linear softmax model trained from real
# `requests` traffic — uses the existing heuristic as a weak label and
# refines complexity from `ab_results.similarity`. Sub-millisecond
# inference, no per-request LLM cost, no extra deps.
#
# When enabled AND a trained artifact is loaded, the classifier replaces
# the regex heuristic for (task_type, complexity) decisions whenever both
# heads cross their calibrated softmax-confidence thresholds. Otherwise
# the heuristic safety net wins.
#
# Two storage modes:
#
#   (a) GLOBAL (single-tenant self-host). One artifact at
#       apps/gateway/src/policy/embedding-classifier.json, trained
#       across every project merged together. Suitable when you run
#       one workload on the gateway. Train with:
#         bun run train-embedding-classifier -- --lookback-days 30
#
#   (b) PER-PROJECT (multi-tenant cloud). One artifact per project
#       row in `project_embedding_classifiers`, trained from THAT
#       project's traffic. Runtime picks project-specific → falls
#       back to global → falls back to heuristic. Train with:
#         bun run train-embedding-classifier -- --project <uuid>
#       or the nightly batch:
#         bun run train-embedding-classifier -- --all-enabled
#       Quality floor defaults to 0.6 on both heads — below-floor
#       trainings land as status='rejected' and don't replace the
#       prior active classifier.
#
# Workflow (GLOBAL):
#   1. Run for a few weeks with the heuristic to accumulate `requests`.
#   2. `bun run train-embedding-classifier`  (writes the disk artifact)
#   3. TOKENSMART_EMBEDDING_CLASSIFIER_ENABLED=1 in env
#   4. Restart the gateway. Boot log shows "[embedding-classifier] loaded
#      v1.<unix_ms> (rows=N, task_type_acc=A, complexity_acc=B)".
#   5. Re-train weekly (cron) so the classifier tracks your traffic shape.
#
# Workflow (PER-PROJECT, hosted / cloud):
#   - Stripe webhook flips `projects.learning_enabled=TRUE` on paid plans.
#   - Wire `bun run train-embedding-classifier -- --all-enabled` to your
#     nightly scheduler (host crontab, GitHub Actions, Kubernetes CronJob,
#     etc.). 03:00 UTC works well — it runs after the daily retention sweep.
#   - Training script emits pg_notify('tokensmart_embedding_reload', ...)
#     after each successful promotion; gateway replicas drop their
#     cached entry for that project within milliseconds.
#   - Operators view / rollback versions at
#     /projects/<id>/classifier in the dashboard.
#
# Setting ENABLED=1 with no artifact present is a safe no-op — the
# loader logs nothing and the heuristic continues to handle every request.
# TOKENSMART_EMBEDDING_CLASSIFIER_ENABLED=0
#
# Override the artifact path (default: src/policy/embedding-classifier.json).
# Useful for testing a candidate artifact or mounting per-tenant artifacts
# from a sidecar volume.
# TOKENSMART_EMBEDDING_CLASSIFIER_PATH=/etc/tokensmart/embedding-classifier.json
#
# Hot-reload: two signal paths, both opt-in.
#   - FILE WATCH (default ON when CLASSIFIER_ENABLED=1): fs.watch on the
#     artifact's parent directory, debounced to one reload per 300ms burst.
#     Set to 0 to disable when running on a filesystem that doesn't
#     support fs.watch reliably (older NFS mounts).
# TOKENSMART_EMBEDDING_CLASSIFIER_WATCH=1
#
#   - pg_notify (multi-replica): the training CLI emits
#     `pg_notify('tokensmart_embedding_reload', ...)` after a successful
#     write. Every gateway process LISTENs on the same channel and
#     reloads. No extra env var — enabled automatically when
#     CLASSIFIER_ENABLED=1 and DATABASE_URL points at Postgres.

# --- Quality proof: embedding similarity for shadow A/B trials ------------

# Enables the dashboard's "Quality proof" card to show semantic similarity
# between primary and shadow responses, not just status-code success.
# When enabled, every shadow A/B trial also fires one embedding call to
# the configured model and stores cosine(primary, shadow) on the
# ab_results row.
#
# Cost: ~$0.0002 per trial at $0.02/M for ~1000 char responses (i.e. ~$0.20
# for a thousand trials). Negligible for most projects.
#
# Leave unset to disable — the card still works, it just shows the coarse
# 2xx-success signal without the similarity layer.
#
# TOKENSMART_QUALITY_EMBED_MODEL=text-embedding-3-small
# TOKENSMART_QUALITY_EMBED_PROVIDER=openai
# TOKENSMART_QUALITY_EMBED_BASE_URL=https://api.openai.com/v1
# (provider's API key resolved from the standard env var, e.g. OPENAI_API_KEY)

# --- OpenTelemetry trace export -------------------------------------------

# Endpoint for an OTLP/HTTP/JSON-compatible collector. Compatible with:
#   - Langfuse Cloud:   https://cloud.langfuse.com/api/public/otel
#   - Self-hosted Langfuse, Tempo, Jaeger, Honeycomb, Phoenix
#   - Datadog OTel collector (point at the agent's OTLP endpoint)
#
# Leave unset to disable export (zero runtime cost in that case).
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# Optional headers, comma-separated key=value pairs. Use this for auth tokens.
#
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>

# Optional service identification. Defaults are tokensmart-gateway / v0.2.0.
# OTEL_SERVICE_NAME=tokensmart-gateway
# OTEL_SERVICE_VERSION=v0.2.0

# --- Per-provider multi-key rotation (round-robin + 429 cooldown) ---------

# Cooldown applied to a key that just returned 429 from upstream. Bench it
# for this many milliseconds so the round-robin picks a different key on
# the immediately-following retry. Default 30 seconds (typical OpenAI
# Retry-After hint). The upstream's `Retry-After` header overrides this
# when provided.
#
# Set to 0 to disable rotation entirely (single-key behavior).
#
# TOKENSMART_KEY_COOLDOWN_MS=30000

# --- Cross-provider failover + retry --------------------------------------

# Automatic retry on transient upstream errors (5xx / 408 / 425 / 429 from the
# UPSTREAM provider, plus network exceptions: ECONNRESET, ETIMEDOUT,
# ECONNREFUSED, undici socket errors). Exponential backoff with full jitter,
# capped at 5 seconds. Retries the SAME provider+model first.
#
# TOKENSMART_RETRY_MAX_ATTEMPTS=2          # default; total attempts = 1 + this
# TOKENSMART_RETRY_BASE_DELAY_MS=200       # backoff base (with jitter)

# Cross-provider failover map: when retries against the original provider
# still fail, swap the model to the configured failover and try ONCE more.
# This is what saves your request when OpenAI is degraded — Anthropic steps
# in transparently. Format: "from1=>to1,from2=>to2" (whitespace tolerated).
#
# Failover honors BYO keys for the failover provider too — if the user has
# uploaded an Anthropic key and "gpt-4o=>claude-3-5-sonnet-latest" is set,
# the failover call uses the user's Anthropic credentials, not the
# gateway's env. If no provider can serve the failover model, the original
# error is returned (failover degrades gracefully, never makes things worse).
#
# Note: failover changes which model your end user is charged for. Pick
# fallback models with comparable quality for your task (the v0.0.9
# baseline policy is a good source of "comparable" pairings).
#
# TOKENSMART_FAILOVER_MAP=gpt-4o=>claude-3-5-sonnet-latest,gpt-4o-mini=>claude-3-5-haiku-latest

# --- Cost anomaly monitor (background) -------------------------------------

# How often to scan projects subscribed to the `cost_anomaly` alert event.
# Default 10 min. Lower it for demos; raise it if Postgres is contended.
# TOKENSMART_ANOMALY_SCAN_MS=600000

# Per-project cooldown between consecutive cost_anomaly alerts. Default 6h
# so a sustained spike doesn't re-fire every scan.
# TOKENSMART_ANOMALY_COOLDOWN_MS=21600000

# --- BYO upstream provider keys -------------------------------------------

# Master key for AES-256-GCM encryption of customer-supplied upstream
# provider credentials (the BYO keys table). Required for the hosted
# multi-tenant deployment so each customer can paste their own OpenAI /
# Anthropic key into the dashboard.
#
# Generate with:
#   openssl rand -hex 32
#
# CRITICAL: this MUST be identical between gateway and dashboard. Rotate
# safely with `bun run rotate-master-key` (never manually edit the var while
# data exists). For self-hosted single-tenant setups you can leave this
# unset; the gateway will fall back to the upstream credentials above.
# TOKENSMART_PROVIDER_KEY_ENCRYPTION=...

# --- BYO keys via AWS KMS (production multi-tenant) ------------------------

# When set, BYO keys are envelope-encrypted: a fresh random DEK per row is
# AES-256-GCM encrypted with, while the DEK itself is wrapped by this KMS
# CMK. KMS takes priority over TOKENSMART_PROVIDER_KEY_ENCRYPTION for new
# writes; env-era rows remain readable until you run
# `bun run migrate-to-kms` to sweep them onto KMS.
#
# IAM policy for the gateway's role needs ONLY these two actions on the
# resource; do not grant kms:Encrypt:
#   {
#     "Effect": "Allow",
#     "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
#     "Resource": "arn:aws:kms:us-east-1:<account>:key/<key-id>"
#   }
#
# TOKENSMART_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/abcd-...
# AWS_REGION=us-east-1
# (Plus whatever credential mechanism — IAM role, env, profile —
#  the standard AWS SDK credential chain already understands.)

# Optional: override the KMS endpoint. Only needed for LocalStack during
# local testing or for a custom VPC endpoint. Leave unset for production.
# TOKENSMART_KMS_ENDPOINT_URL=http://localhost:4566

# --- BYO keys via GCP KMS (alternative to AWS KMS) -------------------------
#
# Exactly one of TOKENSMART_KMS_KEY_ARN (AWS) or TOKENSMART_GCP_KMS_KEY_NAME
# (GCP) may be active at a time. Gateway fails fast at startup if both are
# set.
#
# Key name format (GCP resource path, NOT an ARN):
#   projects/<project>/locations/<loc>/keyRings/<ring>/cryptoKeys/<key>
#
# Auth: Application Default Credentials.
#   - GKE Workload Identity is the preferred path
#   - Or point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON
#   - Or run on GCE / Cloud Run where the metadata server provides creds
#
# Minimum IAM role: roles/cloudkms.cryptoKeyEncrypterDecrypter on the CMK.
# Do NOT grant roles/cloudkms.admin — encrypt/decrypt only.
#
# TOKENSMART_GCP_KMS_KEY_NAME=projects/my-project/locations/global/keyRings/tokensmart/cryptoKeys/byo-keys

# --- KMS decryption cache (applies to AWS + GCP backends) -----------------
#
# In-process LRU of decrypted plaintexts keyed on sha256(envelope). Without
# this, every gateway request against a BYO user costs one KMS Decrypt
# round-trip (~5-20ms + KMS QPS quota). With it, a tight agent loop hits
# KMS once per TTL window. Defaults: 10 min TTL, 1000 entries.
#
# Set either to 0 to disable caching entirely (ultra-paranoid compliance:
# plaintext secrets don't persist in app RAM across requests).
#
# TOKENSMART_KMS_CACHE_TTL_MS=600000
# TOKENSMART_KMS_CACHE_MAX_SIZE=1000

# --- Semantic prompt cache (v0.3) ------------------------------------------
#
# In-memory LRU+TTL cache that serves identical (and optionally semantically-
# near) chat completion requests from RAM at $0 cost. Off by default —
# turn on deliberately because cache eligibility rules deserve thought.
#
# Skipped automatically when:
#   - request is streaming
#   - temperature > 0 (caller wants randomness — no caching)
#   - request includes tools / function_call / response_format=json_schema
#   - prompt is < 8 chars
# Hits land as cost=$0 `requests` rows tagged `cached_by:tokensmart-{exact,similarity}`.
#
# TOKENSMART_CACHE_ENABLED=1
# TOKENSMART_CACHE_MAX_ENTRIES=1000
# TOKENSMART_CACHE_TTL_SECONDS=600
#
# Optional embedding-similarity layer — when threshold > 0, near-match
# prompts also hit the cache. Requires TOKENSMART_QUALITY_EMBED_MODEL
# (same one Quality Proof uses). Costs ~$0.0002 per cache lookup miss.
# 0 (default) = exact-only. 0.95 = conservative semantic match.
# TOKENSMART_CACHE_SIMILARITY_THRESHOLD=0

# --- Internal endpoints (v0.3 request-replay) ------------------------------
#
# Explicit opt-in plus a shared secret authenticating server-to-server calls from the dashboard
# to the gateway's `/internal/*` routes (currently: `/internal/replay`).
# Disabled unless BOTH values are set — the endpoint returns 503 with a clear message.
# Generate with: openssl rand -hex 32
# MUST be byte-identical on the dashboard side too.
#
# TOKENSMART_INTERNAL_REPLAY_ENABLED=1
# TOKENSMART_INTERNAL_TOKEN=

# --- Custom provider egress hardening ---------------------------------------
#
# Hosted/default behavior only allows custom provider base URLs that are public
# HTTPS endpoints and rejects localhost/private/link-local IP targets. Self-host
# operators who intentionally route to private vLLM/Ollama/internal gateways can
# opt in:
#
# TOKENSMART_ALLOW_PRIVATE_PROVIDER_URLS=1

# --- Anonymous aggregate telemetry (self-host opt-in) ------------------------
#
# OFF by default. Self-hosted deployments never phone home unless the operator
# explicitly enables this and runs the sender script (for example from cron).
#
# What is sent:
#   - daily aggregate counts and sums
#   - route pairs (from_model → to_model), landed provider, routing bucket
#   - request_count / project_count / estimated savings
#
# What is NEVER sent:
#   - prompts, responses, request_body, response_body
#   - API keys, user emails, project names, request ids
#   - exact per-request timestamps
#   - route rows below local k-anonymity thresholds
#
# Dry-run (prints the exact JSON that would be sent):
#   TOKENSMART_ANON_TELEMETRY_DEPLOYMENT_ID=replace-with-random-local-id \
#     bun run send-anon-telemetry -- --yesterday --dry-run
#
# Send yesterday's aggregate to TokSuan's hosted collector:
#   TOKENSMART_ANON_TELEMETRY=1 bun run send-anon-telemetry -- --yesterday
#
# TOKENSMART_ANON_TELEMETRY=0
# TOKENSMART_ANON_TELEMETRY_ENDPOINT=https://tokensmt.com/api/telemetry/agent-spend
# TOKENSMART_ANON_TELEMETRY_DEPLOYMENT_ID=replace-with-random-local-id
# TOKENSMART_ANON_TELEMETRY_MIN_ROUTE_REQUESTS=5
# TOKENSMART_ANON_TELEMETRY_MIN_ROUTE_PROJECTS=1


# --- Prompt template runtime substitution (v0.3.x) -----------------------
#
# No env vars to set — the feature is always on for any request that sends
# the `x-ts-template` header. Templates are managed per-project in the
# dashboard at /projects/[id]/templates (CRUD + version history + rollback).
#
# Request-side contract:
#   x-ts-template: <name>           → renders the template's current version
#   x-ts-template: <name>@<int>     → pins to that exact version
#   x-ts-template: <name>@latest    → same as no version
#
# Variable inputs (merged, header wins on key collision):
#   1. body.ts_template_vars    — preferred, supports large multi-line values
#   2. x-ts-template-vars       — JSON-encoded header for tiny vars
#
# The rendered body becomes a system message (replaces messages[0] if it
# was a system message; otherwise prepended). {{var}} placeholders inside
# existing message contents are also substituted. Unknown placeholders are
# left literal so missing-var typos surface immediately.
#
# Each request is auto-tagged `template=<name>` + `template_version=<int>`
# in the request row's `tags` JSONB → "Spend by tag" card breaks out cost
# per template version with no extra schema work.

# ----------------------------------------------------------------------------
# Context compression (input-token saver) — deterministic, opt-in
# ----------------------------------------------------------------------------
#
# Compresses `tool` / `function` messages before forwarding upstream so a
# long-running agent pays for fewer input tokens on every replayed Bash /
# search / log blob. Heuristic shape detection routes each message to a
# strategy: git status/diff, shell listing, stack trace, NDJSON logs, ANSI
# strip, consecutive-line dedup, AND a JSON SmartCrusher (arrays + objects
# with arrays). Deterministic + idempotent so loop fingerprints stay stable;
# only tool/function content is ever touched.
#
# Mode (supersedes the legacy TOKENSMART_TOOL_COMPRESS_ENABLED switch):
#   off       — pipeline never runs (default)
#   audit     — measure potential savings, DO NOT rewrite the prompt;
#               stamps context_compress_* tags so you can prove the trade
#               before flipping to optimize
#   optimize  — actually compress upstream (legacy ENABLED=1 == optimize)
# Per-call override header: `x-ts-context-compress: off|audit|optimize`
# (and the legacy `x-ts-tool-compress: off`). A header can only downgrade.
# TOKENSMART_CONTEXT_COMPRESS_MODE=off
#
# JSON SmartCrusher knobs:
# TOKENSMART_CONTEXT_COMPRESS_CRUSH_JSON=1   # enable JSON array crushing
# TOKENSMART_CONTEXT_COMPRESS_MIN_ITEMS=10   # arrays shorter than this aren't crushed
# TOKENSMART_CONTEXT_COMPRESS_MAX_ITEMS=20   # upper bound on items kept after a crush
#
# Reversible store (CCR-style): persist the pre-compression originals in
# `compressed_blobs` so an operator can retrieve the untouched bytes from
# the request-detail page / GET /internal/compressed. Off by default.
# TOKENSMART_CONTEXT_COMPRESS_STORE=0
#
# Legacy per-message knobs (still honored):
# TOKENSMART_TOOL_COMPRESS_ENABLED=0
# TOKENSMART_TOOL_COMPRESS_MIN_MESSAGE_CHARS=500
# TOKENSMART_TOOL_COMPRESS_MAX_COMPRESSED_CHARS=4000
# TOKENSMART_TOOL_COMPRESS_STRIP_ANSI=1
# TOKENSMART_TOOL_COMPRESS_DEDUP_LINES=1
# TOKENSMART_TOOL_COMPRESS_EXCLUDE_TOOLS=search_web,vision_describe
