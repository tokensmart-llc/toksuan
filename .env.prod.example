# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
#
# This file is deliberately long — a production install has a lot of
# knobs. Everything except `POSTGRES_PASSWORD` is optional; the stack
# boots with safe defaults and progressively unlocks features as you
# fill more in. Scan top-to-bottom once, then come back when you want
# to enable a specific capability.

# =========================================================================
# REQUIRED — Postgres
# =========================================================================
POSTGRES_USER=tokensmart
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=tokensmart

# =========================================================================
# Exposed host ports (change if 8787/3000 are already in use on the host)
# =========================================================================
GATEWAY_PORT=8787
DASHBOARD_PORT=3000

# =========================================================================
# Auth mode — multi-tenant (default) vs single-tenant
# =========================================================================
# Default: multi-tenant auth on. Users sign up at /login (email OTP),
# mint their own API keys at /projects, paste provider keys at /settings.
# This is the well-trodden path and matches what hosted tokensmt.com does.
#
# Single-tenant alternative: set TOKENSMART_AUTH_ENABLED=0 if you're the
# only operator and don't want an auth layer. The dashboard's /projects
# + /settings + /organization pages will redirect to /, and on first
# boot the gateway will mint a bootstrap API key and print it in its
# logs (`docker logs tokensmart-gateway`). Copy that key once and use
# it for all workloads against this box.
# TOKENSMART_AUTH_ENABLED=1

# =========================================================================
# Upstream provider keys (add only what you actually use)
# =========================================================================
# These are the OPERATOR's provider keys — billed to you, shared across
# every user on this deployment. If you want per-user billing (each user
# pays their own OpenAI invoice), skip these and use the BYO flow below
# instead.
#
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
#
# GOOGLE_API_KEY=...
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#
# QWEN_API_KEY=...
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# DOUBAO_API_KEY=...
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# =========================================================================
# Public gateway URL — what the dashboard shows users as the chat endpoint
# =========================================================================
# Unset defaults to http://localhost:8787, which is right for dev and
# wrong for anything reachable over the network. Set this to your
# public hostname so copy-paste curl snippets in the dashboard Just Work.
# NEXT_PUBLIC_BASE_URL=https://tokensmart.example.com
# GATEWAY_PUBLIC_URL=https://gateway.tokensmart.example.com

# =========================================================================
# BYO provider key crypto (multi-tenant hosted mode)
# =========================================================================
# When users paste their own OpenAI / Anthropic keys into /settings,
# we AES-256-GCM encrypt them before writing to Postgres. The dashboard
# encrypts (on paste) and the gateway decrypts (per request); BOTH
# processes need the identical master key.
#
# Pick ONE of:
#   (a) env master key — fine for single-host prod
#       Generate with: openssl rand -hex 32
#       TOKENSMART_PROVIDER_KEY_ENCRYPTION=<paste_hex>
#
#   (b) AWS KMS envelope encryption — recommended for hosted SaaS
#       Minimum IAM: kms:GenerateDataKey + kms:Decrypt on the CMK
#       TOKENSMART_KMS_KEY_ARN=arn:aws:kms:...:key/...
#
#   (c) GCP KMS envelope encryption
#       Auth via Application Default Credentials
#       TOKENSMART_GCP_KMS_KEY_NAME=projects/.../keyRings/.../cryptoKeys/...
#
# Unset = BYO disabled, gateway uses the env keys above.

# =========================================================================
# Dashboard → Gateway internal replay endpoint (optional)
# =========================================================================
# Shared secret for the /requests/[id] "Replay this request" button.
# Same value on BOTH processes. Generate with: openssl rand -hex 32
# TOKENSMART_INTERNAL_REPLAY_ENABLED=1
# TOKENSMART_INTERNAL_TOKEN=

# =========================================================================
# Hosted-mode branding toggle (for the real tokensmt.com deployment)
# =========================================================================
# Flips user-facing copy ("paste your OpenAI key in /settings" instead of
# "edit apps/gateway/.env"), hides operator-only warnings from paying
# customers, and unlocks the weekly-digest next-send hint. Leave unset
# on self-hosted installs.
# TOKENSMART_HOSTED_MODE=1

# =========================================================================
# Stripe billing (optional — for the /billing upgrade flow)
# =========================================================================
# Monthly price IDs (required for checkout):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_SCALE=price_...
#
# Annual price IDs (optional — only needed when a customer asks to
# pay annually; the dashboard shows the annual rate regardless):
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_TEAM_ANNUAL=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...

# =========================================================================
# Email delivery via Resend (for sign-in OTPs + org invites + digest)
# =========================================================================
# Without Resend, auth still works in dev ("code printed to server log")
# but NOT in prod — real customers can't read your docker logs. In
# prod you almost always want Resend (or a swap to another provider).
#
# Verify YOUR OWN domain in Resend first — the default `onboarding@resend.dev`
# sender triggers Gmail Spam and gets rate-limited. The dashboard
# surfaces a warning card when RESEND_FROM uses resend.dev.
# RESEND_API_KEY=re_...
# RESEND_FROM=TokSuan <login@mail.your-domain.com>
#
# Production suppresses plaintext OTP/magic-link logs by default. Set this only
# for a trusted self-host emergency/debug session, then turn it back off.
# TOKENSMART_LOG_LOGIN_CODES=0

# =========================================================================
# Observability (optional)
# =========================================================================
# One span per request emitted via OTLP/HTTP/JSON. Works with Langfuse
# Cloud, Honeycomb, Datadog OTel collector, Tempo, Phoenix, Jaeger.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# =========================================================================
# Request body size limit (gateway)
# =========================================================================
# Defaults to 10 MiB. Raise for vision-heavy workloads that inline
# large base64 images; lower for public deployments where DoS risk
# is a concern.
# TOKENSMART_MAX_BODY_BYTES=10485760

# =========================================================================
# CORS (optional — only needed for browser-side integrations)
# =========================================================================
# Unset = CORS disabled. Backend / server-side SDK callers don't need
# this; it only matters when a browser (Vercel AI SDK client-side,
# web playgrounds, extensions) calls the gateway directly.
#
# Values:
#   "*"                              — any origin (permissive, no creds)
#   "https://app1.com,https://app2"  — exact-match allowlist
#
# TOKENSMART_CORS_ALLOW_ORIGINS=

# =========================================================================
# Documentation base URL (for in-app "see integration guides" links)
# =========================================================================
# Defaults to the GitHub repo. Override to point at your own docs
# mirror, e.g. a Notion/Docusaurus site.
# NEXT_PUBLIC_DOCS_URL=https://docs.tokensmt.com

# =========================================================================
# Scheduled jobs (cron) — run these on a schedule outside the compose file
# =========================================================================
# The compose file does NOT run any cron — schedule these externally:
#
#   bun run sweep-old-requests        # daily 02:30 UTC — enforce retention
#                                     # window on requests + ab_results
#                                     # (gated on env below; unset = no-op)
#   bun run sweep-expired-auth        # daily 03:00 UTC — tombstone sessions
#                                     # + magic_links past grace windows
#   bun run sweep-expired-api-keys    # daily  — hard-delete rotation grace keys
#   bun run sweep-deleted-users       # daily  — hard-delete users past 30d
#   bun run send-weekly-savings       # Mon 10:00 UTC — weekly digest email
#   bun run settle-referrals          # daily 04:30 UTC — Stripe referral credits
#
# Options:
#   - GitHub Actions cron (see .github/workflows/*.yml)
#   - Host crontab calling `docker exec tokensmart-dashboard bun run <script>`
#   - A sidecar `cron` container in your own compose override
# Correctness doesn't depend on these running (grace keys are filtered at
# read time, deleted users are filtered by the auth layer), but without
# them `requests` + tombstone tables grow indefinitely and retention
# claims in SECURITY.md go unenforced.
#
# Retention window for `requests` + `ab_results` (prompt bodies). Hosted
# tokensmt.com commits to 90 days per SECURITY.md; self-hosters leave
# unset = keep forever (operator owns retention per their DPA).
# TOKENSMART_REQUEST_RETENTION_DAYS=90
